{
  "name": "afterglow", "private": true, "version": "0.1.0", "type": "module",
  "workspaces": ["apps/web"], "engines": {"node": "24.11.0"},
  "scripts": {
    "dev": "npm run dev -w @afterglow/web", "build": "npm run build -w @afterglow/web",
    "typecheck": "npm run typecheck -w @afterglow/web", "lint": "eslint .",
    "test": "vitest run", "test:e2e": "playwright test", "format": "prettier --write .",
    "format:check": "prettier --check .", "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "unity:build": "node tools/unity/build.mjs", "unity:test": "node tools/unity/build.mjs --test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1", "eslint": "9.39.1", "globals": "17.13.0", "typescript-eslint": "8.71.1",
    "typescript": "5.9.3", "vitest": "5.0.4", "jsdom": "30.1.2", "@testing-library/react": "16.3.3",
    "@playwright/test": "1.64.0", "prettier": "3.9.10"
  }
}
